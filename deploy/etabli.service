[Unit]
Description=ÉTABLI — serveur (devis de menuiserie)
# Après Docker : derrière Coolify, ÉTABLI écoute sur l'IP de la passerelle Docker, qui n'existe qu'une fois
# Docker démarré. Sans limite de tentatives, le service finit de toute façon par démarrer au redémarrage du serveur.
After=network-online.target docker.service
StartLimitIntervalSec=0

[Service]
User=etabli
Group=etabli
EnvironmentFile=/etc/etabli/env
WorkingDirectory=/opt/etabli/current/server
ExecStart=/usr/bin/node /opt/etabli/current/server/server.js
Restart=always
RestartSec=2

# Durcissement : le processus ne peut écrire que dans le dossier des données
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/etabli
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
